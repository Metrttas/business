            }
          ]
        },
        "options": {}
      },
      "id": "8c312e1b-d2fd-489d-ac3e-a1840babf6ad",
      "name": "Add Lead to CRM Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $('Validate & Clean Data').first().json.email }}",
        "subject": "=Thanks for reaching out, {{ $('Validate & Clean Data').first().json.first_name }}!",
        "emailType": "text",
        "message": "=Hi {{ $('Validate & Clean Data').first().json.first_name }},\n\nThanks for getting in touch about your {{ $('Validate & Clean Data').first().json.interest.toLowerCase() }} project — we've received your message and a designer will reply personally within one business day.\n\nIn the meantime, feel free to reply to this email with photos, measurements or inspiration links. The more we know, the better our first conversation will be.\n\nWarm regards,\nThe Larkfield Interiors team",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "fe290533-255c-4495-817a-2e56b23f43ac",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        300
      ],
      "webhookId": "b6a7f64f-c6f4-4922-8cde-6ae9a5865e78",
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "YOUR_SLACK_CHANNEL_ID",
          "mode": "id"
        },
        "text": "=:sparkles: *New website lead*\n*Name:* {{ $('Validate & Clean Data').first().json.name }}\n*Email:* {{ $('Validate & Clean Data').first().json.email }}\n*Phone:* {{ $('Validate & Clean Data').first().json.phone || '—' }}\n*Interest:* {{ $('Validate & Clean Data').first().json.interest }}\n*Message:* {{ $('Validate & Clean Data').first().json.message || '—' }}\n\nAdded to the CRM sheet and a welcome email has been sent. Follow-up goes out automatically in 2 days if there's no reply.",
        "otherOptions": {}
      },
      "id": "b558b9ad-fdab-45f2-b910-3ea3bdd28a16",
      "name": "Notify Team in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ],
      "webhookId": "032830ae-7146-484e-8d87-36a3fb643684",
      "credentials": {
        "slackApi": {
          "id": "YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "days"
      },
      "id": "8f3ef890-b07b-4040-8e14-18cb13f11952",
      "name": "Wait 2 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
