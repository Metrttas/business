{
  "name": "Lead → CRM → Follow-up (Example Workflow)",
  "nodes": [
    {
      "parameters": {
        "content": "## Lead → CRM → Follow-up (example)\nFictional example for **Larkfield Interiors** (concept demo).\n\n**Before activating:**\n1. Connect credentials for Google Sheets, Gmail and Slack.\n2. Replace `YOUR_SHEET_ID` with your Leads spreadsheet ID (sheet tab named `Leads`).\n3. Replace `YOUR_SLACK_CHANNEL_ID` with the channel for new-lead alerts.\n4. Point your website form at the Production webhook URL (POST JSON: name, email, phone, interest, message).\n5. Activate the workflow.",
        "height": 300,
        "width": 420,
        "color": 7
      },
      "id": "625bfe9f-8e38-4074-a727-2e9a0a4dc468",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        120
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "0e930bde-2411-485a-906f-819bbcd05d7d",
      "name": "Website Form (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "83ac402d-3fdf-4e7c-bfd2-19ea6c692412"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a39e0c64-68ec-44f3-8556-aa72c9e256ba",
              "name": "name",
              "value": "={{ ($json.body.name || '').trim().replace(/\\s+/g, ' ').toLowerCase().replace(/(^|[\\s'-])([a-z])/g, (m, p, c) => p + c.toUpperCase()) }}",
              "type": "string"
            },
            {
              "id": "2eff5e57-04c4-476a-b54c-3f6637bfca3b",
              "name": "first_name",
              "value": "={{ ($json.body.name || '').trim().split(/\\s+/)[0].toLowerCase().replace(/^./, c => c.toUpperCase()) }}",
              "type": "string"
            },
            {
              "id": "1ec9dc44-0854-44c2-bb10-33d19bcc8c4d",
              "name": "email",
              "value": "={{ ($json.body.email || '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "5352bdaa-c888-46a5-b6f3-fb8519c74995",
              "name": "email_valid",
              "value": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(($json.body.email || '').trim()) }}",
              "type": "boolean"
            },
            {
              "id": "87f2cbf1-417d-49aa-be6b-78093c073e19",
              "name": "phone",
              "value": "={{ ($json.body.phone || '').replace(/[^0-9+]/g, '') }}",
              "type": "string"
            },
            {
              "id": "bf38450e-6149-4e70-8942-6052a75d81ad",
              "name": "interest",
              "value": "={{ ($json.body.interest || 'General enquiry').trim() }}",
              "type": "string"
            },
            {
              "id": "105d91aa-c7dc-4147-af02-2d1ed7f1ebcc",
              "name": "message",
              "value": "={{ ($json.body.message || '').trim() }}",
              "type": "string"
            },
            {
              "id": "cf1336f4-18ea-49f8-80bf-8c4fab9e3c6b",
              "name": "source",
              "value": "Website form",
              "type": "string"
            },
            {
              "id": "6666df2f-f700-43fa-b66b-d252ad9c287f",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5c54c915-c12d-4609-83ff-7c18ef6b01e8",
      "name": "Validate & Clean Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "01e7e7cb-db16-49de-acad-7fad907f4604",
              "leftValue": "={{ $json.email_valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "9d567ef3-a821-43a2-a9c5-4c8402313d2b",
              "leftValue": "={{ $json.name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "141501f5-e122-4314-9a59-fc8ba863473f",
      "name": "Keep Valid Leads Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.received_at }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Interest": "={{ $json.interest }}",
            "Message": "={{ $json.message }}",
            "Source": "={{ $json.source }}",
            "Status": "New"
