        300
      ],
      "webhookId": "166548a2-459e-4a60-8cf5-72cf4c33316e"
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 1,
        "filters": {
          "q": "=from:{{ $('Validate & Clean Data').first().json.email }} newer_than:3d"
        }
      },
      "id": "0f48de7c-98a2-43dc-835d-9bfd59c5ca55",
      "name": "Check Inbox for Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1540,
