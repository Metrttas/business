      ],
      "webhookId": "69ebd190-03ad-4a34-9675-4fbf0b1ac27a",
      "alwaysOutputData": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
